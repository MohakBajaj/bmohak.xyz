# Copy to .env. Both values are non-secret.

# Any GitHub-Contributions-API-compatible host.
NEXT_PUBLIC_GITHUB_CONTRIBUTIONS_API_URL=https://github-contributions-api.jogruber.de/v4

# Optional. Lifts the GitHub API rate limit on /about from 60/hr to 5,000/hr.
# No scopes needed. Never commit a real value.
# GITHUB_TOKEN=
